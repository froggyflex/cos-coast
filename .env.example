# Server-only. Never commit .env.local or paste credentials into chat.
MONGODB_URI=mongodb+srv://DATABASE_USER:ENCODED_PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# MONGO_URI is also supported for existing local configurations.
MONGODB_DB=coscoast
MONGODB_COLLECTION_PREFIX=transfer_
NEXTAUTH_URL=http://localhost:3000
PUBLIC_ORIGIN=http://localhost:3000
NEXTAUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=andrea.tallaros7@gmail.com
# Set true only while adding the demo dataset. Disable on a live business site.
SEED_ENABLED=true
# Keep false during testing; set true only for the public launch.
ALLOW_INDEXING=false
# Optional provider webhook; events remain queued if these are absent.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=
# Demo events are held even when a provider is configured, unless enabled here.
NOTIFICATION_SEND_DEMO=false
